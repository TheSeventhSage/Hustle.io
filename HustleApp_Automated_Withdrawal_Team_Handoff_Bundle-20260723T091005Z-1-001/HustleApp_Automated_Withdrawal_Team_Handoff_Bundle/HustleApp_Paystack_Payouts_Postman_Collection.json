{
  "info": {
    "name": "HustleApp API — Paystack Automated Payouts",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Production-ready request collection for HustleApp wallet withdrawals and Paystack Transfers. No live secret key is stored in this collection."
  },
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "Login Client",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"client@example.com\",\n  \"password\": \"Password123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "List Categories",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/categories",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "categories"
          ]
        }
      }
    },
    {
      "name": "Create Booking",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{token}}"
          },
          {
            "key": "X-Idempotency-Key",
            "value": "booking-001"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"provider_service_id\": 1,\n  \"booking_mode\": \"scheduled\",\n  \"scheduled_start_at\": \"2026-04-30 10:00:00\",\n  \"expected_duration_minutes\": 120,\n  \"service_location_text\": \"Lekki, Lagos\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/bookings",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "bookings"
          ]
        }
      }
    },
    {
      "name": "Paystack Automated Payouts",
      "description": "Use a company-controlled Ghana account and a small approved amount for the first live test. Webhook and approval endpoints are called by Paystack, not by the mobile app.",
      "item": [
        {
          "name": "List supported Ghana payout banks",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallet/payout-banks?country=ghana&currency=GHS&type=ghipss",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet",
                "payout-banks?country=ghana&currency=GHS&type=ghipss"
              ]
            },
            "description": "List supported Ghana payout banks"
          },
          "response": []
        },
        {
          "name": "Resolve and verify the beneficiary account name",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallet/bank-accounts/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet",
                "bank-accounts",
                "resolve"
              ]
            },
            "description": "Resolve and verify the beneficiary account name",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bank_code\": \"{{bankCode}}\",\n  \"account_number\": \"{{accountNumber}}\",\n  \"currency_code\": \"GHS\",\n  \"recipient_type\": \"ghipss\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Create a verified Paystack transfer recipient and save the payout account",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallet/bank-accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet",
                "bank-accounts"
              ]
            },
            "description": "Create a verified Paystack transfer recipient and save the payout account",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"bank_code\": \"{{bankCode}}\",\n  \"account_number\": \"{{accountNumber}}\",\n  \"currency_code\": \"GHS\",\n  \"recipient_type\": \"ghipss\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "List the provider’s saved payout accounts",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallet/bank-accounts",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet",
                "bank-accounts"
              ]
            },
            "description": "List the provider’s saved payout accounts"
          },
          "response": []
        },
        {
          "name": "Request a withdrawal and send the HustleApp confirmation OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              },
              {
                "key": "X-Idempotency-Key",
                "value": "{{idempotencyKey}}",
                "type": "text",
                "description": "Use a new value per logical operation. Reuse only after a timeout/network retry of the same request."
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallet/withdrawals",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet",
                "withdrawals"
              ]
            },
            "description": "Request a withdrawal and send the HustleApp confirmation OTP",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": \"10.00\",\n  \"payout_bank_account_id\": \"{{payoutBankAccountId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Verify the provider OTP, reserve the wallet funds, and move the request to approval or queueing",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/wallet/withdrawals/{{withdrawalId}}/verify-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "wallet",
                "withdrawals",
                "{{withdrawalId}}",
                "verify-otp"
              ]
            },
            "description": "Verify the provider OTP, reserve the wallet funds, and move the request to approval or queueing",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp_code\": \"{{withdrawalOtp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Approve the withdrawal and queue the Paystack transfer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "withdrawals",
                "{{withdrawalId}}",
                "approve"
              ]
            },
            "description": "Approve the withdrawal and queue the Paystack transfer",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Requeue a reconciled non-refunded payout using its original immutable reference",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/retry",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "withdrawals",
                "{{withdrawalId}}",
                "retry"
              ]
            },
            "description": "Use only after reconciliation confirms the transfer has no final Paystack outcome, no wallet refund, no active queue job, and no unsafe existing transfer. Final failed/refunded payouts must not be retried.",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Reconcile the local withdrawal against Paystack’s transfer status",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/verify",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "withdrawals",
                "{{withdrawalId}}",
                "verify"
              ]
            },
            "description": "Reconcile the local withdrawal against Paystack’s transfer status",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Finalize a Paystack transfer only while merchant transfer OTP is enabled",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/finalize-otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "withdrawals",
                "{{withdrawalId}}",
                "finalize-otp"
              ]
            },
            "description": "Finalize a Paystack transfer only while merchant transfer OTP is enabled",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"{{paystackTransferOtp}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Decline an approved withdrawal and refund the reserved wallet amount exactly once",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/decline",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "withdrawals",
                "{{withdrawalId}}",
                "decline"
              ]
            },
            "description": "Decline an approved withdrawal and refund the reserved wallet amount exactly once",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"failure_reason\": \"Declined during controlled rollout\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Place a payout under manual review without marking it paid",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/withdrawals/{{withdrawalId}}/manual-review",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "admin",
                "withdrawals",
                "{{withdrawalId}}",
                "manual-review"
              ]
            },
            "description": "Place a payout under manual review without marking it paid",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"reason\": \"Placed under manual review for reconciliation\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Transfer Approval reachability check — an empty or mismatched request must be rejected with HTTP 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/paystack/transfer-approval",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "paystack",
                "transfer-approval"
              ]
            },
            "description": "Transfer Approval reachability check — an empty or mismatched request must be rejected with HTTP 400",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Webhook reachability check — an unsigned request must be rejected safely and must never change wallet data",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/payments/webhooks/paystack",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "payments",
                "webhooks",
                "paystack"
              ]
            },
            "description": "Webhook reachability check — an unsigned request must be rejected safely and must never change wallet data",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api-v2.hustleapp.info/api/v1",
      "description": "HustleApp API v1 base URL"
    },
    {
      "key": "token",
      "value": "",
      "description": "Provider bearer token"
    },
    {
      "key": "adminToken",
      "value": "",
      "description": "Admin bearer token"
    },
    {
      "key": "bankCode",
      "value": "",
      "description": "Paystack Ghana bank code returned by /wallet/payout-banks"
    },
    {
      "key": "accountNumber",
      "value": "",
      "description": "Company-controlled Ghana account number for testing"
    },
    {
      "key": "payoutBankAccountId",
      "value": "",
      "description": "Saved payout bank account ID"
    },
    {
      "key": "withdrawalId",
      "value": "",
      "description": "Withdrawal request ID"
    },
    {
      "key": "withdrawalOtp",
      "value": "",
      "description": "Provider withdrawal confirmation OTP"
    },
    {
      "key": "paystackTransferOtp",
      "value": "",
      "description": "Paystack transfer OTP used only while merchant transfer confirmation is enabled"
    },
    {
      "key": "idempotencyKey",
      "value": "",
      "description": "Generate a new UUID or unique string for each bank-account registration or withdrawal request; reuse it only when retrying the same HTTP operation."
    }
  ]
}
